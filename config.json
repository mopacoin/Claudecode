{
  "interval_s": 5,
  "sensor_timeout_s": 120,
  "web": {
    "host": "0.0.0.0",
    "port": 8080,
    "token": null
  },
  "sensors": {
    "air": {
      "driver": "sim"
    }
  },
  "outputs": {
    "light": {
      "type": "gpio",
      "pin": 17,
      "active_low": true,
      "min_switch_s": 30
    },
    "fan": {
      "type": "gpio",
      "pin": 27,
      "active_low": true,
      "min_switch_s": 30
    },
    "heater": {
      "type": "gpio",
      "pin": 22,
      "active_low": true,
      "min_switch_s": 60
    },
    "humidifier": {
      "type": "gpio",
      "pin": 23,
      "active_low": true,
      "min_switch_s": 60
    },
    "pump": {
      "type": "gpio",
      "pin": 24,
      "active_low": true,
      "max_on_s": 120
    },
    "dehumidifier": {
      "type": "tuya",
      "dev_id": "bfcd6f992aa79104ddbt0w",
      "local_key": "${TUYA_LOCAL_KEY}",
      "address": "Auto",
      "version": "auto",
      "dp": 2,
      "value_on": 30,
      "value_off": 65,
      "min_switch_s": 120
    },
    "zuluft": {
      "type": "meross_local",
      "role": "intake",
      "ip": "192.168.178.34",
      "key": "${MEROSS_KEY}",
      "min_switch_s": 30
    },
    "abluft_servo": {
      "type": "mqtt_servo",
      "role": "vent",
      "topic": "servo/sg92r/set",
      "angle_on": 90,
      "angle_off": 0,
      "payload": "{\"angle\": {angle}}",
      "retain": false
    }
  },
  "light": {
    "on": "06:00",
    "off": "00:00"
  },
  "climate": {
    "temp_day": 25,
    "temp_night": 20,
    "temp_hyst": 1.0,
    "hum_day": 60,
    "hum_night": 55,
    "hum_hyst": 5,
    "fan_min_per_hour": 5
  },
  "irrigation": {
    "enabled": true,
    "interval_min": 720,
    "duration_s": 30,
    "from_hour": 6,
    "to_hour": 22
  },
  "mqtt": {
    "host": "127.0.0.1",
    "port": 1883,
    "username": null,
    "password": null
  }
}