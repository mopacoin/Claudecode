[Unit]
Description=Growcontroller
After=network.target

[Service]
EnvironmentFile=-/home/pi/Claudecode/.env
User=pi
WorkingDirectory=/home/pi/Claudecode
ExecStart=/home/pi/Claudecode/.venv/bin/python -m growcontroller -c config.json --data data
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
